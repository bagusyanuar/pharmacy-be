# Application Configuration
APP_PORT=3000
APP_ENV=development

# Database Configuration (PostgreSQL default)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Database Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Logging
LOG_FILE_PATH=storage/logs/app.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

# Authentication & JWT
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
JWT_ISSUER=go-backend-template

JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=168h

REFRESH_TOKEN_COOKIE_NAME=refresh_token

# CORS (Comma separated URLs, leave empty for none)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
